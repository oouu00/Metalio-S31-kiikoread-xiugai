# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/
build/
/_site/
*.o
*.a
*.out
*.exe # For any host-side utilities compiled on Windows

# Local full VF used to generate main/assets/builtin.ttf
tools/fonts/
/ChillDuanSansVF.ttf
tools/buzzer_score_wav
# Full fonts are local test data; only the built-in subset is distributed.
/sdcard/fonts/
/flash/fonts/
/flash/sdcard/fonts/
/flash/read-pico-fonts.zip
/flash-backups/

# Per-machine task handoff ledger; protocol lives in docs/HANDOFF.md
/docs/HANDOFF.local.md

# 内部计划、审查与验收记录；不随产品交付。
# Internal plans, reviews and acceptance records are not product deliverables.
/docs/local/

# Per-machine IDE config (absolute toolchain paths, serial port)
.vscode/

# ESP-IDF specific build outputs
*.bin
!main/assets/*.bin
!/flash/bootloader.bin
!/flash/partitions.bin
!/flash/firmware.bin
!/flash/ota_data_initial.bin
!/flash/Pico-update*.bin
!/flash/releases/*/bootloader.bin
!/flash/releases/*/partitions.bin
!/flash/releases/*/ota_data_initial.bin
*.elf
*.map
flasher_args.json # Generated in build directory
sdkconfig.old
sdkconfig

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/
# 自包含工具链（esp-idf + 工具链 + python venv），整包拷进项目 .idf/ 实现换机编译
# Self-contained toolchain bundle (esp-idf + toolchain + python venv) under .idf/
.idf/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.cache/
.clangd
.clangd/
.ccls-cache/
compile_commands.json

# 组件手工备份
_component_backups/

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
*.workspace # General workspace files, can be from various tools
*.suo       # Visual Studio Solution User Options
*.sln.docstates # Visual Studio

# Official binaries live in Releases; local packages are hydrated for website builds.
/flash/firmware.bin
/flash/bootloader.bin
/flash/partitions.bin
/flash/ota_data_initial.bin
/flash/Pico-update.bin
/flash/Pico-update-*.bin

# Public website is maintained in read-pico-reader; this private repo carries firmware.
/flash/
/build-*/
/sdkconfig.pico
# release / debug 两档各一份本机构建配置，都不进版本库。
# One local sdkconfig per profile (release/debug); neither belongs in the repo.
/sdkconfig.metalio47*

# Serial capture artifacts (read_serial.py / read_serial2.py output)
serial_*.txt
serial_*.err
bt_*.err
mon.err
*.pid

# 2026-10-31：串口采集与复现日志统一收在 logs/（内容已由 *.log 忽略，这里显式标注）
logs/
